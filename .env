# ====================
# BGE Embedding Models
# ====================
# BGE-M3 模型本地路径
BGE_M3_PATH=D:/doc/ai_models/modelscope_cache/models/models/BAAI--bge-m3/snapshots/master
# BGE-M3 模型名称
BGE_M3=BAAI/bge-m3
# 嵌入模型运行设备
BGE_DEVICE=cpu
# 是否使用半精度（True/False）
BGE_FP16=False
# BGE 重排序模型路径
